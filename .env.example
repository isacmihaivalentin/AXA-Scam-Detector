# Copy to .env, fill in, then load it before starting:  set -a; source .env; set +a
# Never commit the real file. All keys stay on the server; the browser never sees them.

# --- Semantic AI (primary interpreter + screenshot OCR) -------------------------
GEMINI_API_KEY=
# Model ID (default gemini-3.5-flash-lite). Any generateContent model with JSON output works.
GEMINI_MODEL=gemini-3.5-flash-lite
# Per-request deadline in ms (3000-60000, default 20000), retries for 429/5xx/timeouts (0-2, default 1),
# and concurrent provider calls (1-16, default 4).
AXA_GEMINI_TIMEOUT_MS=20000
AXA_GEMINI_RETRIES=1
AXA_GEMINI_CONCURRENCY=4
# Set to 0 to force local-only analysis even when a key is present.
AXA_GEMINI=1

# --- Optional URL reputation (Google Cloud Web Risk Lookup API) -----------------
AXA_WEB_RISK_API_KEY=

# --- Catalog database ------------------------------------------------------------
# SQLite (default ./axa.sqlite3, created by `python database.py`)
AXA_SQLITE_PATH=
# PostgreSQL / Supabase (read-only runtime role). Needs: pip install "psycopg[binary]>=3.2,<4"
AXA_DATABASE_URL=

# --- Optional offline mDeBERTa model (experimental, off by default) -------------
AXA_LOCAL_MODEL=0
AXA_MODEL_DIR=
